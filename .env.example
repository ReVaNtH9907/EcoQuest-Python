# ============================================================
# EcoQuest — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-key

# Database (SQLite used locally; will switch to Supabase PostgreSQL)
DATABASE_URL=sqlite:///ecoquest.db

# Supabase (do not fill until integration phase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI verification service (do not fill until integration phase)
AI_SERVICE_API_KEY=
