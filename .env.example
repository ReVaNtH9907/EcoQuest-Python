# ============================================================
# EcoQuest — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values for local dev.
# For Vercel production deployment, configure these under
# Project Settings -> Environment Variables.
# NEVER commit .env with real credentials to version control.
# ============================================================

# Flask Environment & Core Security
FLASK_ENV=development
# In production, SECRET_KEY must be a cryptographically strong string (minimum 16 chars)
SECRET_KEY=replace-with-a-strong-random-key

# Database Configuration
# Local fallback: SQLite
# Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Note: Both postgres:// and postgresql:// URL prefixes are automatically normalized.
DATABASE_URL=sqlite:///instance/ecoquest.db

# Supabase Storage & Services (Server-Side Only)
# SUPABASE_URL: e.g. https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=
# SUPABASE_ANON_KEY: Client-facing public key (if needed)
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Kept strictly server-side for backend storage operations. Never exposed to browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket names (create in Supabase Dashboard):
SUPABASE_STORAGE_PROFILES_BUCKET=profile-pictures
SUPABASE_STORAGE_EVIDENCE_BUCKET=mission-evidence

# AI Verification Service
AI_SERVICE_API_KEY=

# Mail Configuration (Optional - for Email OTP verification)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ecoquest.org
